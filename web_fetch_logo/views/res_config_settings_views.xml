<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.web.fetch.logo</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@name='contacts_setting_container']" position="inside">
                <setting string="Logo-hämtning (logo.dev)">
                    <div class="w-50">
                        <label for="web_fetch_logo_logo_dev_api_key"
                               string="logo.dev API-nyckel"/>
                        <field name="web_fetch_logo_logo_dev_api_key"
                               widget="password"/>
                    </div>
                    <div class="text-muted">
                        Används som första källa när en företagslogo hämtas
                        (t.ex. "Fetch Logo" i keykeep/bifrost, som sparar på
                        res.partner). Utan nyckel startar kedjan på
                        icon.horse → Google → egen scraping.
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
