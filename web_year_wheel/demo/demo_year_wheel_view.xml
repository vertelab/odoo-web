<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo: Year Wheel view for calendar events -->
    <record id="view_calendar_event_year_wheel" model="ir.ui.view">
        <field name="name">calendar.event.year_wheel.demo</field>
        <field name="model">calendar.event</field>
        <field name="type">year_wheel</field>
        <field name="arch" type="xml">
            <year_wheel string="Year Wheel" date_field="start" color_field="name"
                        label_field="name" start_month="1" segments="12"/>
        </field>
    </record>

    <record id="action_calendar_event_year_wheel" model="ir.actions.act_window">
        <field name="name">Year Wheel</field>
        <field name="res_model">calendar.event</field>
        <field name="view_mode">year_wheel,calendar,list,form</field>
        <field name="view_id" ref="view_calendar_event_year_wheel"/>
    </record>

    <menuitem id="menu_calendar_year_wheel"
              name="Year Wheel"
              action="action_calendar_event_year_wheel"
              parent="base.menu_reporting"
              sequence="20"/>
</odoo>
