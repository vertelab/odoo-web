<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_grid" model="ir.ui.view">
        <field name="name">res.partner.grid.demo</field>
        <field name="model">res.partner</field>
        <field name="type">grid</field>
        <field name="arch" type="xml">
            <grid string="Partner Grid" adjustment="object">
                <field name="company_type" type="row"/>
                <field name="country_id" type="col"/>
                <field name="name" type="measure"/>
            </grid>
        </field>
    </record>

    <record id="action_partner_grid" model="ir.actions.act_window">
        <field name="name">Partner Grid</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">grid,kanban,list,form</field>
        <field name="view_id" ref="view_partner_grid"/>
    </record>
</odoo>
