<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_crm_lead_cohort" model="ir.ui.view">
        <field name="name">res.partner.cohort.demo</field>
        <field name="model">res.partner</field>
        <field name="type">cohort</field>
        <field name="arch" type="xml">
            <cohort string="Partner Retention" date_start="create_date" date_stop="write_date"
                    interval="month" mode="retention" timeline="forward" measure="__count"/>
        </field>
    </record>

    <record id="action_crm_lead_cohort" model="ir.actions.act_window">
        <field name="name">Partner Cohort</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">cohort,kanban,list,form</field>
        <field name="view_id" ref="view_crm_lead_cohort"/>
    </record>

